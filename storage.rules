rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Candidate profile photos — only owner writes their own file
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && fileName == request.auth.uid + '.jpg'
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Recruiter contact photos (the HR person's face)
    match /recruiter_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && fileName == request.auth.uid + '.jpg'
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // Company logos
    match /company_logos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && fileName == request.auth.uid + '.jpg'
          && request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
  }
}
