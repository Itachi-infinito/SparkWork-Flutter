rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMatchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.candidateUserId == request.auth.uid
          || m.recruiterUserId == request.auth.uid;
    }

    function isAdminUser() {
      return isAuth()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // User accounts — l'utilisateur gère son propre profil, mais ne peut
    // jamais s'attribuer isAdmin ni lever lui-même le mode restreint
    // (isRestricted) : ces deux champs sont exclusivement gérés par les
    // Cloud Functions (Admin SDK, qui ignore ces règles).
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == userId
          && request.resource.data.isAdmin == false
          && (!('isRestricted' in request.resource.data)
              || request.resource.data.isRestricted == false);
      allow update: if isAuth() && request.auth.uid == userId
          && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
          && request.resource.data.get('isRestricted', false) == resource.data.get('isRestricted', false);
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // Sessions actives — une seule par appareil. La création (isActive:
    // true) passe uniquement par la Cloud Function createActiveSession
    // (Admin SDK) pour capturer l'IP côté serveur ; le client ne peut que
    // désactiver ses PROPRES sessions (déconnexion manuelle ou "Déconnecter
    // les autres appareils"), jamais en réactiver une.
    match /active_sessions/{sessionId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdminUser());
      allow update: if isAuth() && resource.data.userId == request.auth.uid
          && (request.resource.data.isActive == resource.data.isActive
              || request.resource.data.isActive == false);
      allow create, delete: if false;
    }

    // Anomalies de sécurité — écriture uniquement par les Cloud Functions
    // (détection + résolution via le Callable resolveSecurityFlag).
    match /security_flags/{flagId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdminUser());
      allow write: if false;
    }

    // Logs de sécurité (90 jours, RGPD) — jamais lus ni écrits par le
    // client directement ; la suppression sur demande passe par un Callable.
    match /security_logs/{userId}/events/{eventId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Codes de déblocage du mode restreint — jamais accessibles directement,
    // uniquement via les Callables requestRestrictedUnlockOtp /
    // verifyRestrictedUnlockOtp.
    match /security_otps/{userId} {
      allow read, write: if false;
    }

    // Dashboard sécurité admin — agrégé par Cloud Function quotidienne.
    match /security_dashboard/{docId} {
      allow read: if isAdminUser();
      allow write: if false;
    }

    // Candidate profiles — anyone reads, only owner writes
    match /candidate_profiles/{profileId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.userId == request.auth.uid;
    }

    // Recruiter profiles — anyone reads, only owner writes
    match /recruiter_profiles/{profileId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.userId == request.auth.uid;
    }

    // Ambiance visuelle (système de thèmes) — uniquement le recruteur propriétaire.
    match /recruiter_profiles/{profileId}/settings/{settingId} {
      allow read, write: if isAuth() && request.auth.uid == profileId;
    }

    // Job offers — anyone reads, only owning recruiter writes
    match /job_offers/{offerId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.recruiterUserId == request.auth.uid;
    }

    // Candidate likes a job offer
    // Lecture limitée : le candidat voit ses likes, le recruteur voit les
    // likes reçus sur ses offres (vérifié via le doc de l'offre).
    match /candidate_job_likes/{docId} {
      allow read: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          get(/databases/$(database)/documents/job_offers/$(resource.data.jobOfferId))
              .data.recruiterUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.candidateUserId == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.candidateUserId == request.auth.uid;
    }

    // Recruiter likes a candidate
    // Lecture limitée aux deux parties concernées.
    match /recruiter_candidate_likes/{docId} {
      allow read: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid;
      // Le recruteur supprime ses likes ; le candidat peut aussi purger
      // les likes le concernant (suppression de compte RGPD)
      allow delete: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
    }

    // Matches — only participants read/write/delete
    match /matches/{matchId} {
      allow read: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
      allow create: if isAuth() && (
          request.resource.data.candidateUserId == request.auth.uid ||
          request.resource.data.recruiterUserId == request.auth.uid);
      allow update: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
      // Suppression de compte : un participant peut effacer ses matches
      allow delete: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
    }

    // Messages (flat collection with matchId field)
    match /messages/{msgId} {
      allow read: if isAuth() && isMatchParticipant(resource.data.matchId);
      allow create: if isAuth()
          && request.resource.data.senderUserId == request.auth.uid
          && isMatchParticipant(request.resource.data.matchId);
      // markAsSeen uniquement : seul le champ seenAt peut être modifié,
      // et seulement sur les messages reçus (pas les siens)
      allow update: if isAuth()
          && isMatchParticipant(resource.data.matchId)
          && resource.data.senderUserId != request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['seenAt']);
      // Suppression de compte : un participant peut effacer les messages
      // de ses conversations (les messages avant le match — cf. purge)
      allow delete: if isAuth()
          && isMatchParticipant(resource.data.matchId);
    }

    // Évaluations mutuelles après match
    match /ratings/{ratingId} {
      // L'auteur relit sa propre note ; le destinataire peut lire les
      // notes le concernant (moyenne de profil)
      allow read: if isAuth() && (
          resource.data.fromUserId == request.auth.uid ||
          resource.data.toUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && isMatchParticipant(request.resource.data.matchId);
      // Upsert : l'auteur peut modifier sa note
      allow update: if isAuth()
          && resource.data.fromUserId == request.auth.uid
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;
      allow delete: if isAuth()
          && resource.data.fromUserId == request.auth.uid;
    }

    // Propositions d'entretien — créées par le recruteur du match,
    // lues/répondues par les deux parties
    match /interviews/{interviewId} {
      allow read: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid
          && isMatchParticipant(request.resource.data.matchId);
      // Candidat : accepte/refuse ; recruteur : annule.
      // Les participants ne peuvent pas se réattribuer le doc.
      allow update: if isAuth()
          && (resource.data.recruiterUserId == request.auth.uid ||
              resource.data.candidateUserId == request.auth.uid)
          && request.resource.data.recruiterUserId
              == resource.data.recruiterUserId
          && request.resource.data.candidateUserId
              == resource.data.candidateUserId
          && request.resource.data.matchId == resource.data.matchId;
      // Re-proposition / purge : le recruteur supprime ses propositions ;
      // le candidat peut purger celles le concernant (suppression compte)
      allow delete: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
    }

    // Signalements — écriture seule par le signaleur, lecture admin
    // uniquement (via la console / un back-office, jamais le client)
    match /reports/{reportId} {
      allow create: if isAuth()
          && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Abonnements recruteurs — lecture/écriture par le propriétaire
    match /recruiter_subscriptions/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;

      // Création initiale : uniquement l'essai gratuit (plan free + trial).
      allow create: if isAuth() && request.auth.uid == userId
          && request.resource.data.plan == 'free'
          && request.resource.data.status == 'trial';

      // Auto-expiration de son propre essai (trial -> expired) uniquement —
      // empêche un client de s'attribuer Starter/Pro lui-même.
      allow update: if isAuth() && request.auth.uid == userId
          && resource.data.status == 'trial'
          && request.resource.data.status == 'expired'
          && request.resource.data.plan == resource.data.plan;

      // Tout passage à un plan payant, renouvellement ou annulation réelle
      // est écrit uniquement par la Cloud Function webhook RevenueCat
      // (Admin SDK, qui ignore ces règles).
    }

    // Quotas de swipes — lecture/écriture par le propriétaire
    match /swipe_quotas/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Crédits de boost — lecture/écriture par le propriétaire
    match /boost_credits/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Moyennes de notes — lecture par tous, écriture serveur (Cloud Function)
    match /average_ratings/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Recommandations — gestion par le candidat concerné
    match /recommendations/{recId} {
      allow read: if isAuth() && (
          resource.data.candidateId == request.auth.uid ||
          resource.data.status == 'approved');
      allow create: if isAuth()
          && request.resource.data.candidateId == request.auth.uid;
      allow update: if isAuth() && (
          resource.data.candidateId == request.auth.uid ||
          resource.data.status == 'pending');
      allow delete: if isAuth()
          && resource.data.candidateId == request.auth.uid;
    }

    function isTeamMember(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return team.companyId == request.auth.uid
          || ('memberIds' in team && team.memberIds.hasAny([request.auth.uid]));
    }

    // Équipes — membres lisent (via memberIds, dénormalisé — members est un
    // tableau de maps qu'on ne peut pas indexer par clé ici), propriétaire écrit.
    match /teams/{teamId} {
      allow read: if isAuth() && (
          ('memberIds' in resource.data && resource.data.memberIds.hasAny([request.auth.uid])) ||
          resource.data.companyId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.companyId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.companyId == request.auth.uid;
    }

    // Votes d'équipe sur les candidatures
    match /swipe_votes/{voteId} {
      allow read: if isAuth();
      allow create, update: if isAuth()
          && request.resource.data.voterId == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.voterId == request.auth.uid;
    }

    // Notes internes d'équipe sur un candidat — jamais visibles par le
    // candidat lui-même, uniquement par les membres de l'équipe concernée.
    match /teams/{teamId}/candidate_notes/{candidateId} {
      allow read, write: if isTeamMember(teamId);
    }

    // Cache des SparkScores — calculé et écrit uniquement par la Cloud
    // Function calculateSparkScore (Admin SDK), lecture libre aux recruteurs
    // connectés (aucune donnée sensible, juste un score de compatibilité).
    match /sparkscores/{scoreId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Analyse candidat approfondie (Pro) — calculée par Cloud Function
    // quotidienne. Le candidat ne doit JAMAIS voir ses propres métriques
    // (taux de réponse, popularité...) — anonymisé à son égard.
    match /candidate_analytics/{candidateId} {
      allow read: if isAuth() && request.auth.uid != candidateId;
      allow write: if false;
    }

    // Rapport de candidature automatique (Pro) — généré à la création du
    // match, lisible par les deux parties concernées.
    match /match_reports/{matchId} {
      allow read: if isMatchParticipant(matchId);
      allow write: if false;
    }

    // Pipeline de recrutement visuel (Pro) — uniquement le recruteur propriétaire.
    match /recruiter_pipeline/{recruiterId}/cards/{cardId} {
      allow read, write: if isAuth() && request.auth.uid == recruiterId;
    }

    // Radar de talents — SparkInvite. Le candidat ne doit jamais savoir
    // qu'il a été repéré via le radar — il ne voit que l'invitation reçue.
    match /sparkInvites/{inviteId} {
      allow read: if isAuth() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.receiverId == request.auth.uid);
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuth() && resource.data.receiverId == request.auth.uid;
      allow delete: if false;
    }

    // Invitations d'équipe
    match /team_invitations/{invId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
          resource.data.invitedByUserId == request.auth.uid ||
          resource.data.email == request.auth.token.email);
    }

    // Rapports d'insights marché — lecture Pro uniquement (vérifié via abo)
    match /insight_reports/{reportId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Historique des profils vus — uniquement par le recruteur concerné.
    match /swipe_history/{entryId} {
      allow read: if isAuth() && resource.data.recruiterId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if isAuth() && resource.data.recruiterId == request.auth.uid
          && request.resource.data.recruiterId == resource.data.recruiterId;
      allow delete: if false;
    }

    // Modèles de messages personnalisés (Pro) — uniquement le recruteur propriétaire.
    match /message_templates/{recruiterId}/templates/{templateId} {
      allow read, write: if isAuth() && request.auth.uid == recruiterId;
    }

    // Favoris candidats — uniquement par le recruteur concerné.
    match /candidate_favorites/{favId} {
      allow read, delete: if isAuth() && resource.data.recruiterId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.recruiterId == request.auth.uid;
      allow update: if false;
    }

    // Partenaires — lecture par tous (pour validation du code)
    match /partners/{partnerId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Filleuls — lecture par le partenaire et le filleul
    match /referrals/{refId} {
      allow read: if isAuth() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.referredUserId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Préférences de notifications — lecture/écriture par le propriétaire
    match /notification_preferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Demandes de vérification d'identité — seul le propriétaire et l'admin
    match /verification_requests/{reqId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Vérification Veriff — doc ID = userId. Écriture uniquement via Cloud
    // Functions (Admin SDK, qui ignore ces règles) ; le client ne fait que lire.
    match /verifications/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
