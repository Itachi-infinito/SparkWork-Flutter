rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isMatchParticipant(matchId) {
      let m = get(/databases/$(database)/documents/matches/$(matchId)).data;
      return m.candidateUserId == request.auth.uid
          || m.recruiterUserId == request.auth.uid;
    }

    // User accounts — only owner writes
    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Candidate profiles — anyone reads, only owner writes
    match /candidate_profiles/{profileId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.userId == request.auth.uid;
    }

    // Recruiter profiles — anyone reads, only owner writes
    match /recruiter_profiles/{profileId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.userId == request.auth.uid;
    }

    // Job offers — anyone reads, only owning recruiter writes
    match /job_offers/{offerId} {
      allow read: if isAuth();
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.recruiterUserId == request.auth.uid;
    }

    // Candidate likes a job offer
    // Lecture limitée : le candidat voit ses likes, le recruteur voit les
    // likes reçus sur ses offres (vérifié via le doc de l'offre).
    match /candidate_job_likes/{docId} {
      allow read: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          get(/databases/$(database)/documents/job_offers/$(resource.data.jobOfferId))
              .data.recruiterUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.candidateUserId == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.candidateUserId == request.auth.uid;
    }

    // Recruiter likes a candidate
    // Lecture limitée aux deux parties concernées.
    match /recruiter_candidate_likes/{docId} {
      allow read: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid;
      // Le recruteur supprime ses likes ; le candidat peut aussi purger
      // les likes le concernant (suppression de compte RGPD)
      allow delete: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
    }

    // Matches — only participants read/write/delete
    match /matches/{matchId} {
      allow read: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
      allow create: if isAuth() && (
          request.resource.data.candidateUserId == request.auth.uid ||
          request.resource.data.recruiterUserId == request.auth.uid);
      allow update: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
      // Suppression de compte : un participant peut effacer ses matches
      allow delete: if isAuth() && (
          resource.data.candidateUserId == request.auth.uid ||
          resource.data.recruiterUserId == request.auth.uid);
    }

    // Messages (flat collection with matchId field)
    match /messages/{msgId} {
      allow read: if isAuth() && isMatchParticipant(resource.data.matchId);
      allow create: if isAuth()
          && request.resource.data.senderUserId == request.auth.uid
          && isMatchParticipant(request.resource.data.matchId);
      // markAsSeen uniquement : seul le champ seenAt peut être modifié,
      // et seulement sur les messages reçus (pas les siens)
      allow update: if isAuth()
          && isMatchParticipant(resource.data.matchId)
          && resource.data.senderUserId != request.auth.uid
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['seenAt']);
      // Suppression de compte : un participant peut effacer les messages
      // de ses conversations (les messages avant le match — cf. purge)
      allow delete: if isAuth()
          && isMatchParticipant(resource.data.matchId);
    }

    // Évaluations mutuelles après match
    match /ratings/{ratingId} {
      // L'auteur relit sa propre note ; le destinataire peut lire les
      // notes le concernant (moyenne de profil)
      allow read: if isAuth() && (
          resource.data.fromUserId == request.auth.uid ||
          resource.data.toUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && isMatchParticipant(request.resource.data.matchId);
      // Upsert : l'auteur peut modifier sa note
      allow update: if isAuth()
          && resource.data.fromUserId == request.auth.uid
          && request.resource.data.fromUserId == request.auth.uid
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;
      allow delete: if isAuth()
          && resource.data.fromUserId == request.auth.uid;
    }

    // Propositions d'entretien — créées par le recruteur du match,
    // lues/répondues par les deux parties
    match /interviews/{interviewId} {
      allow read: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.recruiterUserId == request.auth.uid
          && isMatchParticipant(request.resource.data.matchId);
      // Candidat : accepte/refuse ; recruteur : annule.
      // Les participants ne peuvent pas se réattribuer le doc.
      allow update: if isAuth()
          && (resource.data.recruiterUserId == request.auth.uid ||
              resource.data.candidateUserId == request.auth.uid)
          && request.resource.data.recruiterUserId
              == resource.data.recruiterUserId
          && request.resource.data.candidateUserId
              == resource.data.candidateUserId
          && request.resource.data.matchId == resource.data.matchId;
      // Re-proposition / purge : le recruteur supprime ses propositions ;
      // le candidat peut purger celles le concernant (suppression compte)
      allow delete: if isAuth() && (
          resource.data.recruiterUserId == request.auth.uid ||
          resource.data.candidateUserId == request.auth.uid);
    }

    // Signalements — écriture seule par le signaleur, lecture admin
    // uniquement (via la console / un back-office, jamais le client)
    match /reports/{reportId} {
      allow create: if isAuth()
          && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Abonnements recruteurs — lecture/écriture par le propriétaire
    match /recruiter_subscriptions/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Quotas de swipes — lecture/écriture par le propriétaire
    match /swipe_quotas/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Crédits de boost — lecture/écriture par le propriétaire
    match /boost_credits/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Moyennes de notes — lecture par tous, écriture serveur (Cloud Function)
    match /average_ratings/{userId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == userId;
    }

    // Recommandations — gestion par le candidat concerné
    match /recommendations/{recId} {
      allow read: if isAuth() && (
          resource.data.candidateId == request.auth.uid ||
          resource.data.status == 'approved');
      allow create: if isAuth()
          && request.resource.data.candidateId == request.auth.uid;
      allow update: if isAuth() && (
          resource.data.candidateId == request.auth.uid ||
          resource.data.status == 'pending');
      allow delete: if isAuth()
          && resource.data.candidateId == request.auth.uid;
    }

    // Équipes — membres lisent, propriétaire écrit
    match /teams/{teamId} {
      allow read: if isAuth() && (
          resource.data.members[request.auth.uid] != null ||
          resource.data.companyId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.companyId == request.auth.uid;
      allow update, delete: if isAuth()
          && resource.data.companyId == request.auth.uid;
    }

    // Votes d'équipe sur les candidatures
    match /swipe_votes/{voteId} {
      allow read: if isAuth();
      allow create, update: if isAuth()
          && request.resource.data.voterId == request.auth.uid;
      allow delete: if isAuth()
          && resource.data.voterId == request.auth.uid;
    }

    // Invitations d'équipe
    match /team_invitations/{invId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
          resource.data.invitedByUserId == request.auth.uid ||
          resource.data.email == request.auth.token.email);
    }

    // Rapports d'insights marché — lecture Pro uniquement (vérifié via abo)
    match /insight_reports/{reportId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Partenaires — lecture par tous (pour validation du code)
    match /partners/{partnerId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // Filleuls — lecture par le partenaire et le filleul
    match /referrals/{refId} {
      allow read: if isAuth() && (
          resource.data.partnerId == request.auth.uid ||
          resource.data.referredUserId == request.auth.uid);
      allow create: if isAuth()
          && request.resource.data.referredUserId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Préférences de notifications — lecture/écriture par le propriétaire
    match /notification_preferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // Demandes de vérification d'identité — seul le propriétaire et l'admin
    match /verification_requests/{reqId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth()
          && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
